# Safe runtime configuration
APP_ENV=development
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000

# Phase 2: Supabase. Keep the service-role key server-only.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 11: Supabase Auth social login.
# Configure Google OAuth in the Supabase dashboard and Google Cloud.
# Apple remains dormant until its provider setup and application gate are enabled.
# Provider credentials live in Supabase, not in Vercel environment variables.
# APP_BASE_URL must be present so OAuth callbacks resolve to this app.

# Owner access uses a separate signed session. Generate at least 32 characters.
# SESSION_SIGNING_SECRET=

# Phase 4 email transport. Keep `test` for automated/local safe transport.
EMAIL_TRANSPORT=test
# Set EMAIL_TRANSPORT=smtp only with the dedicated Gmail sender below.
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=
# OWNER_EMAIL=

# Phase 6 ingestion worker. Never prefix these with NEXT_PUBLIC_.
# Generate an independent value with at least 32 characters.
# CRON_SHARED_SECRET=
INGESTION_BATCH_SIZE=4
INGESTION_LEASE_SECONDS=300
INGESTION_TIMEOUT_MS=8000
INGESTION_MAX_RESPONSE_BYTES=2097152

# Phase 7 shared story summaries. Clustering and evidence checks are entirely
# local; the provider is used only for summaries. Never prefix with NEXT_PUBLIC_.
INTELLIGENCE_PROVIDER=disabled
# Set INTELLIGENCE_PROVIDER=groq to enable the recommended summary provider.
# GROQ_API_KEY=
GROQ_GENERATION_MODEL=openai/gpt-oss-20b
# Gemini remains an optional provider if it is needed later.
# GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
INTELLIGENCE_BATCH_SIZE=5
INTELLIGENCE_LEASE_SECONDS=300
INTELLIGENCE_CANDIDATE_LIMIT=12
INTELLIGENCE_CANDIDATE_LOOKBACK_HOURS=96
SHARED_SUMMARY_BATCH_SIZE=4
SHARED_SUMMARY_LEASE_SECONDS=420
PROVIDER_TIMEOUT_MS=20000
PROVIDER_MAX_ATTEMPTS=1
# These conservative defaults leave room below Groq's published free-plan
# request/token ceilings. Confirm the exact limits shown for your own account.
PROVIDER_REQUESTS_PER_MINUTE=25
PROVIDER_INPUT_UNITS_PER_MINUTE=5500
PROVIDER_REQUESTS_PER_DAY=900
PROVIDER_INPUT_UNITS_PER_DAY=160000

# Phase 8 deterministic scheduling and personalization. These workers never
# call a summary provider and never expose subscriber data to the browser.
DELIVERY_SCHEDULER_BATCH_SIZE=50
PERSONALIZATION_BATCH_SIZE=10
PERSONALIZATION_LEASE_SECONDS=180

# Phase 9 briefing delivery. The test transport never sends real email.
DELIVERY_BATCH_SIZE=10
DELIVERY_LEASE_SECONDS=300

# Optional/deferred backup reference. Do not configure these values for the
# personal Vercel beta. They remain only for local testing or a future project
# stage if the owner later chooses to add scheduled backup.
BACKUP_STORAGE_ADAPTER=local
# BACKUP_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# BACKUP_ENCRYPTION_KEY=
# BACKUP_LOCAL_DIRECTORY=
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
BACKUP_UTC_HOUR=2
